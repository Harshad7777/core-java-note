🔹 Appointment-Based Queries
✅ Query 1: Total appointments per patient
SELECT p.patient_id, p.name, COUNT(a.appointment_id) AS total_appointments
FROM patient p
LEFT JOIN appointment a ON p.patient_id = a.patient_id
GROUP BY p.patient_id;
✅ Query 2: Patients with more than 3 appointments
SELECT p.name, COUNT(a.appointment_id) AS total
FROM patient p
JOIN appointment a ON p.patient_id = a.patient_id
GROUP BY p.patient_id
HAVING COUNT(a.appointment_id) > 3;
✅ Query 3: Appointments per doctor
SELECT d.doctor_id, d.name, COUNT(a.appointment_id) AS total_appointments
FROM doctor d
LEFT JOIN appointment a ON d.doctor_id = a.doctor_id
GROUP BY d.doctor_id;
✅ Query 4: Doctors with more than 5 appointments
SELECT d.name, COUNT(a.appointment_id) AS total
FROM doctor d
JOIN appointment a ON d.doctor_id = a.doctor_id
GROUP BY d.doctor_id
HAVING COUNT(a.appointment_id) > 5;
✅ Query 5: Appointments per date
SELECT DATE(appointment_date) AS app_date, COUNT(*) AS total
FROM appointment
GROUP BY app_date;
✅ Query 6: Patient with maximum appointments
SELECT p.name, COUNT(a.appointment_id) AS total
FROM patient p
JOIN appointment a ON p.patient_id = a.patient_id
GROUP BY p.patient_id
ORDER BY total DESC
LIMIT 1;
✅ Query 7: Doctors with no appointments
SELECT d.name
FROM doctor d
LEFT JOIN appointment a ON d.doctor_id = a.doctor_id
WHERE a.appointment_id IS NULL;
✅ Query 8: Patients per doctor
SELECT d.name, COUNT(DISTINCT a.patient_id) AS total_patients
FROM doctor d
LEFT JOIN appointment a ON d.doctor_id = a.doctor_id
GROUP BY d.doctor_id;
✅ Query 9: Average appointments per patient
SELECT AVG(total) AS avg_appointments
FROM (
    SELECT COUNT(*) AS total
    FROM appointment
    GROUP BY patient_id
) t;
✅ Query 10: Patients with multiple doctors
SELECT p.name, COUNT(DISTINCT a.doctor_id) AS doctor_count
FROM patient p
JOIN appointment a ON p.patient_id = a.patient_id
GROUP BY p.patient_id
HAVING COUNT(DISTINCT a.doctor_id) > 1;
🔹 Department-Based Queries
✅ Query 11: Doctors per department
SELECT dpt.dept_name, COUNT(dd.doctor_id) AS total_doctors
FROM department dpt
LEFT JOIN doctor_department dd ON dpt.dept_id = dd.dept_id
GROUP BY dpt.dept_id;
✅ Query 12: Departments with > 2 doctors
SELECT dpt.dept_name, COUNT(dd.doctor_id) AS total
FROM department dpt
JOIN doctor_department dd ON dpt.dept_id = dd.dept_id
GROUP BY dpt.dept_id
HAVING COUNT(dd.doctor_id) > 2;
✅ Query 13: Departments with no doctors
SELECT dpt.dept_name
FROM department dpt
LEFT JOIN doctor_department dd ON dpt.dept_id = dd.dept_id
WHERE dd.doctor_id IS NULL;
✅ Query 14: Doctors in multiple departments
SELECT d.name, COUNT(dd.dept_id) AS dept_count
FROM doctor d
JOIN doctor_department dd ON d.doctor_id = dd.doctor_id
GROUP BY d.doctor_id
HAVING COUNT(dd.dept_id) > 1;
✅ Query 15: Appointments per department
SELECT dpt.dept_name, COUNT(a.appointment_id) AS total
FROM department dpt
JOIN doctor_department dd ON dpt.dept_id = dd.dept_id
JOIN appointment a ON dd.doctor_id = a.doctor_id
GROUP BY dpt.dept_id;
✅ Query 16: Department with highest appointments
SELECT dpt.dept_name, COUNT(a.appointment_id) AS total
FROM department dpt
JOIN doctor_department dd ON dpt.dept_id = dd.dept_id
JOIN appointment a ON dd.doctor_id = a.doctor_id
GROUP BY dpt.dept_id
ORDER BY total DESC
LIMIT 1;
🔹 Room & Admission Queries
✅ Query 17: Patients per room
SELECT r.room_id, COUNT(a.patient_id) AS total_patients
FROM room r
LEFT JOIN admission a ON r.room_id = a.room_id
GROUP BY r.room_id;
✅ Query 18: Rooms with > 2 patients
SELECT r.room_id, COUNT(a.patient_id) AS total
FROM room r
JOIN admission a ON r.room_id = a.room_id
GROUP BY r.room_id
HAVING COUNT(a.patient_id) > 2;
✅ Query 19: Revenue per room
SELECT r.room_id, SUM(b.total_amount) AS revenue
FROM room r
JOIN admission a ON r.room_id = a.room_id
JOIN bill b ON a.admission_id = b.admission_id
GROUP BY r.room_id;
✅ Query 20: Avg stay duration per room
SELECT r.room_id, 
AVG(DATEDIFF(discharge_date, admit_date)) AS avg_days
FROM room r
JOIN admission a ON r.room_id = a.room_id
GROUP BY r.room_id;
✅ Query 21: Rooms never used
SELECT r.room_id
FROM room r
LEFT JOIN admission a ON r.room_id = a.room_id
WHERE a.room_id IS NULL;
🔹 Billing Queries
✅ Query 22: Total bill per patient
SELECT p.name, SUM(b.total_amount) AS total_bill
FROM patient p
JOIN bill b ON p.patient_id = b.patient_id
GROUP BY p.patient_id;
✅ Query 23: Patients with bill > 50000
SELECT p.name, SUM(b.total_amount) AS total
FROM patient p
JOIN bill b ON p.patient_id = b.patient_id
GROUP BY p.patient_id
HAVING SUM(b.total_amount) > 50000;
✅ Query 24: Average bill
SELECT AVG(total_amount) AS avg_bill
FROM bill;
✅ Query 25: Bills per patient
SELECT p.name, COUNT(b.bill_id) AS total_bills
FROM patient p
LEFT JOIN bill b ON p.patient_id = b.patient_id
GROUP BY p.patient_id;
✅ Query 26: Patients with > 2 bills
SELECT p.name, COUNT(b.bill_id) AS total
FROM patient p
JOIN bill b ON p.patient_id = b.patient_id
GROUP BY p.patient_id
HAVING COUNT(b.bill_id) > 2;
🔹 Advanced Revenue Queries
✅ Query 27: Revenue per doctor
SELECT d.name, SUM(b.total_amount) AS revenue
FROM doctor d
JOIN appointment ap ON d.doctor_id = ap.doctor_id
JOIN admission ad ON ap.patient_id = ad.patient_id
JOIN bill b ON ad.admission_id = b.admission_id
GROUP BY d.doctor_id;
✅ Query 28: Doctors with revenue > 1 lakh
SELECT d.name, SUM(b.total_amount) AS revenue
FROM doctor d
JOIN appointment ap ON d.doctor_id = ap.doctor_id
JOIN admission ad ON ap.patient_id = ad.patient_id
JOIN bill b ON ad.admission_id = b.admission_id
GROUP BY d.doctor_id
HAVING SUM(b.total_amount) > 100000;
✅ Query 29: Revenue per department
SELECT dpt.dept_name, SUM(b.total_amount) AS revenue
FROM department dpt
JOIN doctor_department dd ON dpt.dept_id = dd.dept_id
JOIN appointment ap ON dd.doctor_id = ap.doctor_id
JOIN admission ad ON ap.patient_id = ad.patient_id
JOIN bill b ON ad.admission_id = b.admission_id
GROUP BY dpt.dept_id;
✅ Query 30: Patients visiting multiple departments + total bill
SELECT p.name, SUM(b.total_amount) AS total_bill
FROM patient p
JOIN appointment ap ON p.patient_id = ap.patient_id
JOIN doctor_department dd ON ap.doctor_id = dd.doctor_id
JOIN admission ad ON p.patient_id = ad.patient_id
JOIN bill b ON ad.admission_id = b.admission_id
GROUP BY p.patient_id
HAVING COUNT(DISTINCT dd.dept_id) > 1;