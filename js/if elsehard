# Q6. Theme Park Ticket Pricing

Rules:

* Age ≤ 3 → Free
* Age 4–12 → ₹20
* Age 13–64 → ₹100
* Age 65+ → ₹50
* Height > 180 → +₹50
* Height 120–180 → No change
* Height < 120 → 50% discount
* VIP → 10% discount on final price
* Negative age/height → Error

```javascript
let age = Number(prompt("Enter age:"));
let height = Number(prompt("Enter height in cm:"));
let vip = prompt("Do you have VIP pass? (y/n):").toLowerCase();

if (age < 0 || height < 0) {

    console.log("Error: Age cannot be negative and height cannot be negative.");

} else {

    let basePrice;

    // Calculate base price
    if (age <= 3) {
        basePrice = 0;
    } else if (age >= 4 && age <= 12) {
        basePrice = 20;
    } else if (age >= 13 && age <= 64) {
        basePrice = 100;
    } else {
        basePrice = 50;
    }

    let finalPrice = basePrice;

    console.log("========== TICKET DETAILS ==========");
    console.log("Age       : " + age);
    console.log("Height    : " + height + " cm");
    console.log("VIP Pass  : " + vip);
    console.log("Base Price: Rs. " + basePrice.toFixed(2));

    // Height rules
    if (height > 180) {

        finalPrice = finalPrice + 50;

        console.log("Height Charge: Rs. 50");

    } else if (height >= 120 && height <= 180) {

        console.log("Height Charge: Rs. 0");

    } else if (height < 120) {

        finalPrice = finalPrice * 0.50;

        console.log("Height Discount: 50%");

    }

    // VIP discount
    if (vip === "y") {

        let vipDiscount = finalPrice * 0.10;
        finalPrice = finalPrice - vipDiscount;

        console.log("VIP Discount: 10%");

    }

    console.log("Final Ticket Price: Rs. " + finalPrice.toFixed(2));
    console.log("====================================");
}
```

