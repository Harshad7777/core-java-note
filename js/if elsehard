# Q3. Vehicle Service Center

```javascript
let ownerName = prompt("Enter owner's name:");
let vehicleName = prompt("Enter vehicle name:");

let vehicleType = Number(
    prompt("Enter vehicle type (2 for 2-wheeler, 3 for 3-wheeler, 4 for 4-wheeler):")
);

if (vehicleType !== 2 && vehicleType !== 3 && vehicleType !== 4) {

    console.log(
        "This service center is not accepting other than 2 wheeler, 3 wheeler and 4 wheeler"
    );

} else {

    let age = Number(prompt("Enter vehicle age in months:"));

    if (age <= 8) {

        console.log("Your vehicle service will done after a while");

    } else {

        console.log("1. Enter 1 for tyre problem");
        console.log("2. Enter 2 for fuel problem");
        console.log("3. Enter 3 for engine issue");
        console.log("4. Enter 4 for general services");

        let choice = Number(prompt("Enter your choice:"));

        let issue;
        let bill = 0;

        switch (choice) {

            case 1:
                issue = "Tyre Problem";

                let tyres = Number(
                    prompt("How many tyres are you facing the issue?")
                );

                bill = tyres * 400;
                break;

            case 2:
                issue = "Fuel Problem";
                bill = 1500;
                break;

            case 3:
                issue = "Engine Issue";
                bill = 5000;
                break;

            case 4:
                issue = "General Service";
                bill = 1000;
                break;

            default:
                console.log("Invalid choice");
        }

        if (bill > 0) {

            console.log("========== SERVICE BILL ==========");
            console.log("Name of Owner : " + ownerName);
            console.log("Name of Bike  : " + vehicleName);
            console.log("Issue         : " + issue);
            console.log("Bill          : Rs. " + bill);
            console.log("==================================");
        }
    }
}
```

### Example

```text
Name of Owner : Rajesh
Name of Bike  : Honda
Issue         : Tyre Problem
Bill          : Rs. 1200
```

