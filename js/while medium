## Q8. Alternate Digit Sum

```javascript
let num = Number(prompt("Enter a number:"));

let position = 1;
let sum1 = 0;
let sum2 = 0;

while (num > 0) {

    let digit = num % 10;

    if (position % 2 === 1) {
        sum1 = sum1 + digit;
    } else {
        sum2 = sum2 + digit;
    }

    num = Math.floor(num / 10);
    position++;
}

if (sum1 === sum2) {
    console.log("Alternate digit sum is same.");
} else {
    console.log("Alternate digit sum is not same.");
}
```

